# Token do bot, obtido no BotFather (/newbot)
BOT_TOKEN=

# chat_id do grupo (voce + fornecedor + bot). Negativo, ex: -1001234567890
# Descubra chamando https://api.telegram.org/bot<TOKEN>/getUpdates depois de mandar uma mensagem de teste no grupo
SUPPLIER_GROUP_CHAT_ID=

# Chave da API PacoteVicio no RapidAPI (https://rapidapi.com -> PacoteVicio)
RAPIDAPI_KEY=

# Caminho do arquivo SQLite. Normalmente nao precisa definir: por padrao usa
# uma pasta "data" do lado do .exe (ou da pasta do projeto, em modo dev).
# DB_PATH=
